RewriteEngine On
RewriteCond %{SERVER_PORT} 80
RewriteRule ^(.*)$ https://airportaxiofficial.be/$1 [R,L]

# RedirectPermanent /index.html https://airportaxiofficial.be/reservation.php

     
<Files "const.php">
    Order Allow,Deny
    Deny from all
</Files>

<Files "utils/const.php">
    Order Allow,Deny
    Deny from all
</Files>